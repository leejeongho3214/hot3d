CONDA_ROOT="${HOME}/miniconda3"
CONDA_SH="${CONDA_ROOT}/etc/profile.d/conda.sh"
CONDA_ENV_DIR="${CONDA_ROOT}/envs/hot3d"

if [ ! -f "${CONDA_SH}" ]; then
  echo "direnv: missing conda init script: ${CONDA_SH}" >&2
  exit 1
fi

if [ ! -d "${CONDA_ENV_DIR}" ]; then
  echo "direnv: missing conda env: ${CONDA_ENV_DIR}" >&2
  exit 1
fi

source "${CONDA_SH}"
conda activate "${CONDA_ENV_DIR}"
